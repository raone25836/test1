# Environment Configuration for Lalee Patle Birthday Experience

# PORT: Server listening port (defaults to 3000 in AI Studio)
PORT=3000

# NODE_ENV: production or development
NODE_ENV="development"

# ADMIN_PASSWORD: Secret password to access Private Vault & Owner Dashboard
# Replace with your own secure password when deploying to production.
# Default fallback if unset: lalee2026
ADMIN_PASSWORD="YOUR_SECURE_ADMIN_PASSWORD"

# APP_URL: The hosted URL of this application
APP_URL="https://your-domain-or-subdomain.onrender.com"
